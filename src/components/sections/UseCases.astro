---
/** Para quién (03 §2, sección 8): cuatro casos de uso, tarjetas con "lift" al hover. */
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Dictionary } from "@/i18n";

interface Props {
  t: Dictionary;
  number: number;
}

const { t, number } = Astro.props;
---

<Section id="use-cases" labelledby="use-cases-title">
  <SectionHeader
    number={number}
    eyebrow={t.useCases.eyebrow}
    title={t.useCases.title}
    titleId="use-cases-title"
    lead={t.useCases.lead}
  />
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {t.useCases.items.map((item, i) => (
      <li
        class="flex flex-col gap-5 border border-ink/10 bg-panel p-7 transition duration-300 ease-out-soft hover:-translate-y-1 hover:border-ink/30"
        data-reveal
        style={`--reveal-index: ${i}`}
      >
        <Icon name={item.icon} class="size-7" />
        <h3 class="text-lg font-bold uppercase leading-tight">{item.title}</h3>
        <p class="text-sm leading-relaxed text-text-2">{item.body}</p>
      </li>
    ))}
  </ul>
</Section>
