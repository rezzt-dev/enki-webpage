---
/** Privacidad (03 §2, sección 7): el árbol real de un almacén + seis garantías verificables en el código. */
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Dictionary } from "@/i18n";

interface Props {
  t: Dictionary;
  number: number;
}

const { t, number } = Astro.props;
---

<Section id="privacy" labelledby="privacy-title">
  <SectionHeader
    number={number}
    eyebrow={t.privacy.eyebrow}
    title={t.privacy.title}
    titleId="privacy-title"
    lead={t.privacy.lead}
  />

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    {/* El nombre accesible va en la figura: `aria-label` no está permitido en `<pre>` (rol genérico). */}
    <figure
      class="self-start border border-ink/10 bg-bg-alt lg:col-span-5"
      aria-label={t.privacy.treeLabel}
      data-reveal
    >
      <figcaption class="flex items-center justify-between border-b border-ink/10 px-5 py-3 font-mono text-[0.625rem] uppercase tracking-[0.2em] text-ink/60">
        <span>~/{t.privacy.tree[0]}</span>
        <Icon name="folder-outline" class="size-4" />
      </figcaption>
      <pre class="overflow-x-auto p-5 font-mono text-sm leading-7 text-text-2 md:p-7">{t.privacy.tree.join("\n")}</pre>
    </figure>

    <ul class="grid gap-px border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:col-span-7">
      {t.privacy.points.map((point, i) => (
        <li class="flex flex-col gap-3 bg-bg p-6" data-reveal style={`--reveal-index: ${i % 2}`}>
          <Icon name={point.icon} class="size-5" />
          <h3 class="font-bold uppercase tracking-[0.05em]">{point.title}</h3>
          <p class="text-sm leading-relaxed text-text-2">{point.body}</p>
        </li>
      ))}
    </ul>
  </div>
</Section>
