---
/**
 * Marco de captura ("passe-partout" de my-web) con la única sombra que permite el sistema.
 *
 * Si la captura del registro (`src/lib/screens.ts`) todavía no tiene imagen, pinta un esquema de la
 * pantalla de la app con su proporción definitiva: sirve para ver la organización de la página y
 * garantiza que la maqueta no se mueva cuando llegue la imagen real.
 */
import { Picture } from "astro:assets";
import { screens, type ScreenId } from "@/lib/screens";

interface Props {
  screen: ScreenId;
  alt: string;
  pendingLabel: string;
  /** Solo para la captura del hero (LCP): sin lazy y con prioridad alta. */
  priority?: boolean;
  class?: string;
  sizes?: string;
}

const {
  screen,
  alt,
  pendingLabel,
  priority = false,
  class: className,
  sizes = "(min-width: 1024px) 66vw, 100vw",
} = Astro.props;
const data = screens[screen];
const isPhone = data.kind === "phone";
const bars = [72, 48, 60, 36, 54];
---

<figure
  class:list={[
    "border border-ink/10 bg-surface p-2 shadow-[0_0_0_1px_color-mix(in_oklab,var(--ink)_6%,transparent),0_24px_48px_rgb(0_0_0/0.35)]",
    isPhone && "mx-auto w-full max-w-[280px]",
    className,
  ]}
>
  {data.src ? (
    <Picture
      src={data.src}
      alt={alt}
      formats={["avif", "webp"]}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="block h-auto w-full"
    />
  ) : (
    <div
      role="img"
      aria-label={`${alt} (${pendingLabel})`}
      class="relative w-full overflow-hidden bg-bg text-ink"
      style={`aspect-ratio: ${data.aspect}`}
      data-screen-placeholder={screen}
    >
      {isPhone ? (
        <div class="absolute inset-0 flex flex-col gap-[4%] p-[8%]">
          <div class="h-[3%] w-1/3 self-center bg-ink/15" />
          <div class="mt-[6%] h-[4%] w-2/3 bg-ink/25" />
          {Array.from({ length: 7 }, (_, i) => (
            <div class="flex h-[7%] items-center gap-[6%] border border-ink/10 px-[6%]">
              <span class="size-2.5 shrink-0 border border-ink/40" />
              <span class="h-1.5 bg-ink/15" style={`width: ${40 + ((i * 17) % 45)}%`} />
            </div>
          ))}
        </div>
      ) : (
        <div class="absolute inset-0 flex">
          <div class="flex w-[17%] flex-col gap-[6%] border-r border-ink/10 bg-ink/[0.03] p-[2.5%]">
            <div class="h-[5%] w-1/2 bg-ink/40" />
            {bars.map((w) => (
              <div class="flex items-center gap-[10%]">
                <span class="aspect-square w-[14%] bg-ink/20" />
                <span class="h-1 bg-ink/15" style={`width: ${w}%`} />
              </div>
            ))}
          </div>
          <div class="flex flex-1 flex-col gap-[3%] p-[3%]">
            <div class="flex h-[6%] items-center justify-between border-b border-ink/10 pb-[2%]">
              <span class="h-2 w-1/4 bg-ink/30" />
              <span class="h-2 w-[12%] border border-ink/20" />
            </div>
            {data.kind === "dashboard" && (
              <div class="grid flex-1 grid-cols-3 grid-rows-[1fr_2fr] gap-[2%]">
                {[0, 1, 2].map(() => (
                  <div class="border border-ink/10 bg-ink/[0.04]" />
                ))}
                <div class="col-span-2 border border-ink/10 bg-ink/[0.04]" />
                <div class="border border-ink/10 bg-ink/[0.04]" />
              </div>
            )}
            {data.kind === "notes" && (
              <div class="flex flex-1 gap-[2%]">
                <div class="flex w-[30%] flex-col gap-[4%] border-r border-ink/10 pr-[2%]">
                  {bars.concat(bars).map((w) => (
                    <span class="h-1.5 bg-ink/15" style={`width: ${w + 20}%`} />
                  ))}
                </div>
                <div class="flex flex-1 flex-col gap-[3.5%] pl-[2%]">
                  <span class="h-3 w-1/2 bg-ink/35" />
                  {[92, 88, 95, 60, 90, 84, 70, 93, 40].map((w) => (
                    <span class="h-1.5 bg-ink/12" style={`width: ${w}%`} />
                  ))}
                </div>
              </div>
            )}
            {data.kind === "kanban" && (
              <div class="grid flex-1 grid-cols-4 gap-[2%]">
                {[3, 2, 4, 1].map((n) => (
                  <div class="flex flex-col gap-[4%] border border-ink/10 p-[4%]">
                    <span class="h-1.5 w-1/2 bg-ink/35" />
                    {Array.from({ length: n }, () => (
                      <div class="h-[16%] border border-ink/15 bg-ink/[0.05]" />
                    ))}
                  </div>
                ))}
              </div>
            )}
            {data.kind === "calendar" && (
              <div class="grid flex-1 grid-cols-7 grid-rows-5 gap-px bg-ink/10">
                {Array.from({ length: 35 }, (_, i) => (
                  <div class="bg-bg p-[6%]">
                    {i % 4 === 1 && <span class="block h-1.5 w-4/5 bg-ink/25" />}
                    {i % 6 === 2 && <span class="mt-1 block h-1.5 w-3/5 border border-ink/30" />}
                  </div>
                ))}
              </div>
            )}
            {data.kind === "reminders" && (
              <div class="flex flex-1 flex-col gap-[3%]">
                {[70, 55, 80, 45, 65, 50].map((w, i) => (
                  <div class="flex h-[11%] items-center gap-[2%] border border-ink/10 px-[2%]">
                    <span class:list={["size-2 shrink-0 rounded-full", i === 0 ? "bg-success" : "bg-ink/30"]} />
                    <span class="h-1.5 bg-ink/15" style={`width: ${w}%`} />
                    <span class="ml-auto h-1.5 w-[10%] bg-ink/20" />
                  </div>
                ))}
              </div>
            )}
            {data.kind === "graph" && (
              <svg viewBox="0 0 100 56" class="flex-1" fill="none" stroke="currentColor" aria-hidden="true">
                <g stroke-opacity="0.25" stroke-width="0.3">
                  <path d="M20 14L42 26L68 12M42 26L36 44L60 40L68 12M60 40L84 34M20 14L12 36L36 44M68 12L84 34" />
                </g>
                <g fill="currentColor" fill-opacity="0.5" stroke="none">
                  {[
                    [20, 14],
                    [42, 26],
                    [68, 12],
                    [36, 44],
                    [60, 40],
                    [84, 34],
                    [12, 36],
                  ].map(([x, y], i) => (
                    <circle cx={x} cy={y} r={i === 1 ? 2.6 : 1.6} />
                  ))}
                </g>
              </svg>
            )}
          </div>
        </div>
      )}
      <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-center justify-between gap-2 border-t border-ink/10 bg-bg/85 px-3 py-2 font-mono text-[0.625rem] uppercase tracking-[0.25em] text-ink/60 backdrop-blur-sm">
        <span>
          {pendingLabel} · {screen}
        </span>
        <span>{data.size}</span>
      </div>
    </div>
  )}
</figure>
