---
/**
 * Monograma "E" de Enki (trazado vectorizado de docs/project-icons, ver docs/roadmap/03 §4.1) + wordmark.
 * El monograma usa `currentColor`, así que sigue al tema.
 */
interface Props {
  class?: string;
  wordmark?: boolean;
}

const { class: className, wordmark = true } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg viewBox="316 217 390 589" class="h-5 w-auto" fill="currentColor" aria-hidden="true">
    <path d="M316 217H706V806H316V728H620V550H391V472H620V296H316Z"></path>
  </svg>
  {/* `-mr` compensa el tracking que queda tras la última letra y descentra el conjunto. */}
  {wordmark && <span class="mr-[-0.3em] text-sm leading-none font-bold uppercase tracking-[0.3em]">Enki</span>}
</span>
