---
/**
 * FAQ con <details> nativo: accesible, sin JS y con el contenido en el HTML (SEO). La misma fuente
 * alimenta el JSON-LD FAQPage (src/lib/jsonld.ts).
 */
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import { fill, type Dictionary } from "@/i18n";
import { site } from "@/lib/site";

interface Props {
  t: Dictionary;
  number: number;
}

const { t, number } = Astro.props;
---

<Section id="faq" alt labelledby="faq-title">
  <SectionHeader number={number} eyebrow={t.faq.eyebrow} title={t.faq.title} titleId="faq-title" />
  <div class="border-t border-ink/10" data-reveal>
    {t.faq.items.map((item, i) => {
      const [before, after] = fill(item.a, { version: site.version }).split("{email}");
      return (
        <details class="faq-item group border-b border-ink/10" data-faq-id={String(i + 1)}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 transition-opacity duration-200 hover:opacity-70 [&::-webkit-details-marker]:hidden">
            <span class="text-lg font-bold leading-snug md:text-xl">{item.q}</span>
            <Icon name="add" class="mt-1 size-5 transition-transform duration-300 ease-out-soft group-open:rotate-45" />
          </summary>
          <p class="max-w-3xl pb-7 leading-relaxed text-text-2">
            {before}
            {after !== undefined && (
              <>
                <a
                  href={`mailto:${site.supportEmail}`}
                  class="text-text underline decoration-ink/40 underline-offset-2 hover:decoration-ink"
                >
                  {site.supportEmail}
                </a>
                {after}
              </>
            )}
          </p>
        </details>
      );
    })}
  </div>
</Section>
