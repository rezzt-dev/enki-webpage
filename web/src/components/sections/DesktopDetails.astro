---
/** Detalles de escritorio (03 §2, sección 9). Atajos verificados en enki/src/enki/services/ShortcutCatalog.cs. */
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Kbd from "@/components/ui/Kbd.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Dictionary } from "@/i18n";

interface Props {
  t: Dictionary;
  number: number;
}

const { t, number } = Astro.props;
---

<Section id="desktop" alt labelledby="desktop-title">
  <SectionHeader
    number={number}
    eyebrow={t.desktop.eyebrow}
    title={t.desktop.title}
    titleId="desktop-title"
    lead={t.desktop.lead}
  />

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <ul class="flex flex-col border-t border-ink/10 lg:col-span-7">
      {t.desktop.shortcuts.map((shortcut, i) => (
        <li
          class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 py-4"
          data-reveal
          style={`--reveal-index: ${i % 3}`}
        >
          <span class="text-sm md:text-base">{shortcut.label}</span>
          <span class="flex items-center gap-1.5">
            {shortcut.keys.map((key, k) => (
              <>
                {k > 0 && (
                  <span class="text-xs text-ink/50" aria-hidden="true">
                    +
                  </span>
                )}
                <Kbd>{key}</Kbd>
              </>
            ))}
          </span>
        </li>
      ))}
    </ul>

    <ul class="grid content-start gap-px border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:col-span-5">
      {t.desktop.extras.map((extra, i) => (
        <li class="flex flex-col gap-3 bg-bg-alt p-6" data-reveal style={`--reveal-index: ${i % 2}`}>
          <Icon name={extra.icon} class="size-5" />
          <h3 class="font-bold uppercase tracking-[0.05em]">{extra.title}</h3>
          <p class="text-sm leading-relaxed text-text-2">{extra.body}</p>
        </li>
      ))}
    </ul>
  </div>
</Section>
