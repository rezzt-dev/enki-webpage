---
/**
 * Hero (03 §2, sección 1): qué es Enki en cinco segundos. CTA primario = descargar la beta (baja a la
 * sección de descargas, donde se elige sistema) y enlace a la release en GitHub; el secundario baja a
 * "Cómo funciona".
 */
import ScreenFrame from "@/components/ui/ScreenFrame.astro";
import Icon from "@/components/ui/Icon.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import StatusDot from "@/components/ui/StatusDot.astro";
import Button from "@/components/ui/Button.astro";
import type { Locale } from "@/i18n/config";
import type { Dictionary } from "@/i18n";
import { release } from "@/lib/release";

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative overflow-hidden pb-20 pt-32 md:pb-28 md:pt-44">
  <Container>
    <Eyebrow class="mb-6 flex items-center gap-3">
      <StatusDot />
      {t.hero.eyebrow}
    </Eyebrow>
    <h1 id="hero-title" class="text-hero font-bold uppercase">
      {t.hero.titleLines.map((line) => (
        <span class="block">{line}</span>
      ))}
    </h1>

    <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-6">
        <p class="max-w-xl text-lg leading-relaxed text-text-2 md:text-xl">{t.hero.lead}</p>
        <a
          href="#how"
          class="group mt-8 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] transition-opacity duration-200 hover:opacity-60"
          data-track="cta_click"
          data-track-id="hero_secondary"
        >
          {t.hero.secondary}
          <Icon name="arrow-forward" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" />
        </a>
      </div>
      <div class="border border-ink/10 bg-panel p-6 md:p-8 lg:col-span-5 lg:col-start-8">
        <p class="eyebrow mb-3 flex items-center gap-3">
          <StatusDot />
          {t.hero.downloadTitle} · v{release.version}
        </p>
        <p class="mb-6 text-sm leading-relaxed text-text-2">
          {release.assets.map((asset) => `${asset.os} ${asset.arch}`).join(" · ")}
        </p>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
          <Button href="#access" data-track="cta_click" data-track-id="hero_download">
            <Icon name="download" class="size-4" />
            {t.hero.downloadCta}
          </Button>
          <a
            href={release.url}
            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] transition-opacity duration-200 hover:opacity-60"
            rel="noopener"
            target="_blank"
            data-track="cta_click"
            data-track-id="hero_release_notes"
          >
            {t.access.releaseNotes}
            <Icon name="arrow-outward" class="size-4" />
          </a>
        </div>
      </div>
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-ink/10 pt-6">
      {t.hero.facts.map((fact) => (
        <li class="flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.2em] text-ink/70">
          <Icon name="check" class="size-4" />
          {fact}
        </li>
      ))}
    </ul>

    <div class="mt-14 md:mt-20" data-reveal style="--reveal-index: 5">
      <ScreenFrame
        screen="dashboard"
        locale={locale}
        alt={t.hero.screenAlt}
        pendingLabel={t.a11y.placeholder}
        priority
        sizes="(min-width: 1350px) 1320px, 100vw"
      />
    </div>
  </Container>
</section>
