# Copia este fichero a `.env` y rellena lo que necesites. Todas son públicas (prefijo PUBLIC_): llegan al
# HTML o al JS del navegador, así que aquí nunca va un secreto.

# Dominio canónico (canonical, hreflang, sitemap, og:image). Por defecto, https://enki.rezzt.dev.
PUBLIC_SITE_URL=https://enki.rezzt.dev

# Formulario "avísame" (D8, Buttondown). Sin ella el formulario avisa de que no está conectado.
PUBLIC_BUTTONDOWN_USER=

# Analítica Umami (D7). Solo se carga si además PUBLIC_DEPLOY_CONTEXT=production.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_DOMAINS=enki.rezzt.dev

# Solo en el despliegue de producción. Nunca en desarrollo ni en previews: así un preview no mide nada.
PUBLIC_DEPLOY_CONTEXT=
